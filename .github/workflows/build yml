name: Build Prysm APK

on:
  push:
    branches: [ main ]
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Set up JDK 21
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '21'

      - name: Set up Gradle
        uses: gradle/actions/setup-gradle@v4

      - name: Configure Last.fm keys (optional)
        env:
          LASTFM_API_KEY: ${{ secrets.LASTFM_API_KEY }}
          LASTFM_SECRET: ${{ secrets.LASTFM_SECRET }}
        run: |
          printf "lastfm.apiKey=%s\nlastfm.secret=%s\n" "$LASTFM_API_KEY" "$LASTFM_SECRET" > local.properties

      - name: Build Prysm Release APK (Side-by-Side)
        run: |
          chmod +x ./gradlew
          ./gradlew :app:assembleRelease -PsideBySide=prysm -PsideByLabel=Prysm

      - name: Upload APK
        uses: actions/upload-artifact@v4
        with:
          name: prysm-apk
          path: app/build/outputs/apk/**/*.apk
          if-no-files-found: error
